# Set these in Vercel → Project → Settings → Environment Variables.
# For running locally, copy this file to backend/.env and fill it in.

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://neondb_owner:npg_XYM3Vol2ykBd@ep-autumn-moon-b4gkefkj-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Admin auth ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=admin2026!
SECRET_KEY=   # python -c "import secrets; print(secrets.token_hex(32))"

# ── Email OTP (Gmail SMTP) ─────────────────────────────────────────────────
# Use a Gmail App Password (not your real password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_EMAIL=mugenimoulaika@gmail.com
SMTP_PASSWORD=admin2026!                    # 16-char App Password
ADMIN_EMAIL=mugenimoulaika@gmail.com # Where OTP codes are sent
# Optional — only for a mail server other than Gmail (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl                           # ssl, starttls or none

# ── Firebase Storage (optional — for receipt uploads) ──────────────────────
# Without these, orders still save but receipts are not stored.
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single line (no newlines)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
